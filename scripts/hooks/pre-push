#!/usr/bin/env bash
#
# Refuse to push commits or annotated tags carrying a non-org identity.
#
# This is the gate that matters. Once a commit reaches the public remote it
# stays reachable by SHA through the upstream repo's URL space, so a later
# force-push does not retract it -- the push itself is the irreversible step,
# which is why the check belongs here and not in CI alone.
#
# git feeds this hook one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A remote sha of all zeroes means the remote does not have the ref yet.
#
set -euo pipefail

check="$(git rev-parse --show-toplevel)/scripts/check-identity.sh"
zero="0000000000000000000000000000000000000000"

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion pushes the zero sha locally; there is nothing to check.
  [[ "$local_sha" == "$zero" ]] && continue

  if [[ "$remote_sha" == "$zero" ]]; then
    # The remote has no such ref yet, so "new" means everything this ref
    # reaches that is not already published on some remote-tracking branch.
    # That keeps a fresh topic branch from re-walking the entire history.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  "$check" --range "$range" || status=1

  # An annotated tag carries a tagger line that no commit range covers.
  if [[ "$local_ref" == refs/tags/* ]]; then
    "$check" --tags || status=1
  fi
done

if [[ $status -ne 0 ]]; then
  echo "error: push refused -- the identity check above failed" >&2
  exit 1
fi
